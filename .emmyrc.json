{
    "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
    "runtime": {
        "version": "Lua5.1"
    },
    "workspace": {
        "library": [
            "~/.vscode/extensions/ketho.wow-api-0.22.3/Annotations/Core"
        ],
        "ignoreDir": [
            "Lib",
            "tests"
        ]
    },
    "diagnostics": {
        "disable": [
            "undefined-field",
            "inject-field",
            "missing-parameter",
            "redundant-parameter"
        ],
        "globals": [
            "ChatFrameUtil",
            "C_Seasons",
            "LeaveParty",
            "WorldFrame",
            "NWB_CurrentLayer",
            "StaticPopup_ForEachShownDialog",
            "UISpecialFrames",
            "ERR_ALREADY_IN_GROUP_S",
            "ERR_DECLINE_GROUP_S",
            "ERR_DUNGEON_DIFFICULTY_CHANGED_S",
            "issecretvalue",
            "SetDesaturation",
            "ERR_GROUP_DISBANDED",
            "ERR_GROUP_FULL",
            "ERR_INVITE_PLAYER_S",
            "ERR_JOINED_GROUP_S",
            "ERR_LEFT_GROUP_S",
            "ERR_LEFT_GROUP_YOU",
            "ERR_NOT_IN_GROUP",
            "ERR_RAID_MEMBER_ADDED_S",
            "ERR_SET_LOOT_FREEFORALL",
            "ERR_SET_LOOT_GROUP",
            "ERR_SET_LOOT_NBG",
            "ERR_SET_LOOT_ROUNDROBIN",
            "ERR_SET_LOOT_THRESHOLD_S"
        ]
    }
}
